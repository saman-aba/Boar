QPushButton {
    background: #2f6fed;
    border: 1px solid #295fc7;
    border-radius: 4px;
    padding: 4px 9px;
    min-height: 24px;
    color: white;
}
QFrame#quickActionsFrame QPushButton {
    min-height: 28px;
    padding: 5px 12px;
}
QPushButton:hover {
    background: #3b7cff;
}
QPushButton:pressed {
    background: #5b93ff;
}
QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox, QTableWidget, QTreeWidget, QListWidget {
    background: #1a1f24;
    border: 1px solid #3b4652;
    border-radius: 4px;
    padding: 2px;
    selection-background-color: #2f6fed;
}
QTabWidget::pane {
    border: 1px solid #3b4652;
    background: #262c33;
}
QTabBar::tab {
    background: #2b323a;
    color: #cfd7df;
    padding: 8px 14px;
    border: 1px solid #3b4652;
    border-bottom: none;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background: #20252b;
}
QHeaderView::section {
    background: #2b323a;
    color: #d7dde5;
    padding: 4px;
    border: 1px solid #3b4652;
}
QListWidget#navList {
    background: #1d2228;
    border-right: 1px solid #3b4652;
    font-size: 10pt;
}
